node_modules

# Lockfiles. This blueprint is npm-first, so package-lock.json is COMMITTED and every other
# manager's lockfile is ignored. Two committed lockfiles for one package.json is the failure this
# prevents: they resolve independently and drift, and nobody notices until a version differs between
# a teammate's install and CI. If you adopt Bun (docs/bun.md) or pnpm, invert this — commit that
# manager's lockfile and ignore package-lock.json instead. Pick exactly one.
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock

# Build output. The blueprint is typecheck-only (tsconfig sets noEmit), so nothing lands here yet —
# the entry is pre-declared for whatever emit strategy the project picks. See README.md.
dist/

# Deliberately NOT ignored: `*.js` / `*.d.ts` repo-wide. The blueprint inherited those two lines from
# a project that compiled TypeScript in place, where they hid the build output sitting next to each
# source file. Here they would silently swallow legitimate committed JavaScript — scripts/*.mjs is
# already committed, and any .js config file (eslint, tailwind, postcss) would vanish without a
# warning. Ignore build output by directory instead.

# Coverage output (COVERAGE.md at the repo root is committed; the raw report is not)
coverage

.local/

# Secrets. `.env.example` is committed as the discoverable list of what needs setting; the real
# `.env` never is.
.env

# Config layers: the committed defaults are the exception, every other config.*.toml is a local
# override. The negation must come AFTER the broad pattern — git applies the last matching rule, so
# reordering these two lines silently stops committing config.defaults.toml.
config.*.toml
!config.defaults.toml

# CodeGraph — a per-developer local code-index tool (SQLite db + daemon state).
# Personal tooling, not adopted repo-wide; keep the whole dir out of the repo.
.codegraph/
