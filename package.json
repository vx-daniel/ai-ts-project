{
  "name": "typescript-project-blueprint",
  "version": "0.1.0",
  "description": "Starting point for new TypeScript projects: one gate (Biome + tsc + Vitest), coverage thresholds, and the agent rules under .claude/.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "check:all": "node --import tsx scripts/gate.ts",
    "coverage": "vitest run --coverage && node --import tsx scripts/coverage-to-markdown.ts",
    "coverage:open": "xdg-open coverage/index.html || open coverage/index.html || start coverage/index.html",
    "coverage:readme": "node --import tsx scripts/coverage-to-markdown.ts --readme"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "zod": "^4.4.3"
  }
}
